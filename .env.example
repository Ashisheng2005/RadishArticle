# LLM (required for agent runs)
OPENAI_API_KEY=sk-...
LLM_MODEL=openai:gpt-4o-mini

# Optional: cheaper model for validation / style
LLM_MODEL_LIGHT=openai:gpt-4o-mini

# Web research (optional; falls back to DuckDuckGo)
TAVILY_API_KEY=

# LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=radish-article

# Paths
DATA_ROOT=data/projects

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Chroma vector store (optional)
CHROMA_ENABLED=true
